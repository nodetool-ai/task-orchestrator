# Copy to .env.local and fill in. .env* is gitignored.

# Auth.js v5 — required.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Public origin. Used by NextAuth for redirect URLs and cookie domain.
# Production: https://tasks.nodetool.ai
# Local dev:  http://localhost:3000
NEXTAUTH_URL=https://tasks.nodetool.ai

# Trust the Cloudflare Tunnel as a reverse proxy so NextAuth uses the
# X-Forwarded-Proto/Host headers (https + tasks.nodetool.ai) for cookies
# and callback URLs instead of the underlying http://localhost:3000.
AUTH_TRUST_HOST=true

# Optional: override SQLite location (defaults to ../data.db relative
# to the db/ directory).
# TASK_ORCH_DB=/var/lib/task-orchestrator/data.db

# Optional: point agent sessions at a different checkout. If unset, the
# orchestrator works on its own source tree.
# TASK_ORCH_TARGET_REPO=/path/to/your/repo

# Optional: model + worktree retention for agent runs.
# TASK_ORCH_AGENT_MODEL=claude-sonnet-4-5
# TASK_ORCH_KEEP_WORKTREES=1
# TASK_ORCH_PR_POLL_MS=60000

# DEFAULT agent SDK backend. 'pi' (default) uses @earendil-works/pi-coding-agent;
# 'claude' uses @anthropic-ai/claude-agent-sdk. The 'claude' backend resolves auth
# like the Claude Code CLI: ANTHROPIC_API_KEY when set, otherwise the claude.ai
# subscription (run `claude login` once, or set CLAUDE_CODE_OAUTH_TOKEN from
# `claude setup-token` for headless use). Each run can override this default:
# the run composers' backend picker, POST bodies' `backend` field, and the CLI's
# --backend=pi|claude all set agent_runs.backend per run. Note: a run's
# resumable session is backend-specific — resumes stay on the run's backend.
# TASK_ORCH_AGENT_BACKEND=pi

# Brave Search tool for chats and agent runs. The tool uses the Web Search API
# endpoint and keeps the subscription token server-side.
# BRAVE_SEARCH_API_KEY=

# 'claude' backend auth, in precedence order (first match wins):
# ANTHROPIC_API_KEY=sk-ant-...   # API billing; takes precedence when set
# CLAUDE_CODE_OAUTH_TOKEN=...     # subscription fallback for headless hosts
#                                 # (from `claude setup-token`); or just run `claude login`

# GitHub webhook receiver (POST /api/github/webhook). Set this to a shared
# secret and configure the same secret on your repo/org webhook. Inbound
# deliveries are authenticated via the X-Hub-Signature-256 HMAC. Recommended
# events: pull_request, pull_request_review, issue_comment, check_run,
# check_suite, workflow_run (and/or status). Without this set, the endpoint
# returns 503 and ignores all deliveries.
# GITHUB_WEBHOOK_SECRET=

# Optional: auto-fix. When enabled, a CI failure or "changes requested" review
# on a task's PR resumes the agent on the same branch to fix it and re-push
# (re-triggering CI). Off by default — it spends model budget unattended.
# TASK_ORCH_CI_AUTOFIX=0                      # auto-fix is ON by default; set 0/false/no/off to disable
# TASK_ORCH_CI_AUTOFIX_MAX=3                 # cap auto-fix attempts per run
# TASK_ORCH_CI_AUTOFIX_DEBOUNCE_MS=120000    # ignore repeat triggers in this window

# Burst-event wake debounce (docs/agent-events.md §6.2a): gh.ci.completed /
# gh.pr.pushed deliveries coalesce and wake a parked run once per storm, not
# once per delivery — each wake is a whole LLM turn.
# TASK_ORCH_EVENT_WAKE_QUIET_MS=90000        # wake after this long with no new burst delivery (0 disables)
# TASK_ORCH_EVENT_WAKE_MAX_DELAY_MS=300000   # hard ceiling: wake even if deliveries keep streaming

# Safety cap for implement runs: a worktree turn that ends without a PR re-prompts
# the agent to keep going. This bounds those consecutive no-PR continuations so a
# stuck agent can't loop forever — on exhaustion the run lands `failed`.
# TASK_ORCH_MAX_PR_CONTINUATIONS=25          # max no-PR turns before failing the run

# Optional: proactive scheduler. When enabled, periodically auto-launches an
# agent session on every eligible `todo` task (assignee matches, deps all
# merged, no run already in flight), up to a hard concurrency ceiling — so the
# orchestrator runs autonomously (agent acts → CI gates → merge/block). OFF by
# default; the poll interval is only armed when the master switch is on.
# TASK_ORCH_AUTO_LAUNCH=0                     # master switch: 1/true/yes/on to enable (default off)
# TASK_ORCH_AUTO_LAUNCH_INTERVAL_MS=60000    # poll cadence
# TASK_ORCH_AUTO_LAUNCH_MAX_CONCURRENT=3     # ceiling on active auto-launched runs
# TASK_ORCH_AUTO_LAUNCH_ASSIGNEE=claude      # only tasks with this assignee are eligible
# TASK_ORCH_AUTO_LAUNCH_PLAN=                 # optional: restrict to one plan id (default: all plans)

# ── Discord bridge (npm run pipe) ────────────────────────────────────────────
# Talk to the same chat agent as the web UI (same tools, same persistence) from
# Discord. Standalone & opt-in: the web server never starts it. Create an app +
# bot at https://discord.com/developers/applications, copy the bot token, and
# enable the "Message Content Intent" under Bot → Privileged Gateway Intents.
# Invite the bot with these permissions: "Send Messages", "Read Message History",
# "Create Public Threads", and "Send Messages in Threads" — a message in a normal
# channel opens a thread and the agent session runs inside it.
# DISCORD_BOT_TOKEN=
#
# Comma-separated Discord USER ids allowed to talk to the bot. MANDATORY — the
# agent runs with bypassPermissions and full shell/fs access in the default repo,
# so the bridge refuses to start without an explicit allowlist. (Enable Developer
# Mode in Discord, then right-click a user → Copy User ID.)
# DISCORD_ALLOWED_USERS=111111111111111111,222222222222222222
#
# Optional: restrict to specific channel/DM ids (empty = any channel the
# allow-listed user can reach the bot in).
# DISCORD_ALLOWED_CHANNELS=
#
# Optional: throttle for in-place streaming edits, in ms (default 750). Discord
# rate-limits message edits, so keep this comfortably above ~500ms.
# TASK_ORCH_PIPE_EDIT_MS=750
#
# The bridge reuses TASK_ORCH_CHAT_MODEL (default anthropic/claude-sonnet-4-6) as
# the per-conversation model and TASK_ORCH_TARGET_REPO as the working repo.

# ── Worker HTTP + SSE protocol (docs/worker-http-api.md) ────────────────────
# REQUIRED to dispatch workers: this server's base URL AS REACHABLE FROM
# WORKERS (compose service name, flycast address, or public https origin;
# NEXTAUTH_URL is used as a same-host dev fallback). Every dispatched worker
# receives this URL plus a run-scoped bearer token and speaks /api/worker over
# HTTP + SSE. Workers NEVER receive DATABASE_URL — direct-Postgres workers are
# not supported.
# TASK_ORCH_WORKER_API_URL=http://server:3000
#
# Signing secret for worker tokens (defaults to AUTH_SECRET when unset).
# TASK_ORCH_WORKER_API_SECRET=
#
# Structured logging for the worker protocol surfaces (both ends).
# TASK_ORCH_LOG_LEVEL=info                    # debug | info | warn | error
# TASK_ORCH_LOG_FORMAT=text                   # text | json

# ── Lightweight pi-ai loop (chat + plan executor) ───────────────────────────
# Chat and plan-executor runs with the pi backend (the default) drive
# @earendil-works/pi-ai directly via lib/chat-ai-loop.ts: no SDK session
# files, no per-turn worker container, just the model + the orchestrator's
# server-side tool registry. Lower latency, simpler operational surface.
# Set either flag to "0" to fall back to the full backend harness for that
# goal (Claude session files, runOneTurn).
# TASK_ORCH_LIGHTWEIGHT_CHATS=1               # default on; chats
# TASK_ORCH_LIGHTWEIGHT_EXECUTOR=1            # default on; plan executor
#
# WHERE the lightweight loop executes its model turns:
#   child     (default) a local Node child process (scripts/run-worker.ts) with a
#             bounded V8 heap and inherited env (DATABASE_URL retained → db
#             transport). Keeps the no-container low latency but moves the turn OFF
#             the web-server event loop/heap: a runaway turn is OOM-killed inside
#             the child instead of taking the control plane down. The reaper
#             recovers a dead child (executors re-dispatch, chats idle).
#   inprocess today's original behavior: turns run IN the web-server process.
#             Rollback escape hatch.
# TASK_ORCH_LIGHTWEIGHT_ISOLATION=child
#
# V8 --max-old-space-size (MB) for each lightweight child (0 disables the cap).
# TASK_ORCH_LIGHTWEIGHT_MEMORY_MB=512
#
# Max concurrent lightweight children. Effective concurrency is the MIN of this
# count and what fits in the host memory budget: each child reserves its heap cap
# + ~128MB non-heap overhead (so 512 ⇒ ~640MB) against the SAME budget Docker
# workers draw from — (os.totalmem − TASK_ORCH_HOST_MEMORY_RESERVE_MB) minus what
# live workers (TASK_ORCH_WORKER_MEMORY_MB each) + other live children already
# hold. Over-budget dispatches defer to 'pending' and the pump retries them; a
# single child whose reservation exceeds the whole budget fails as "never-fits".
# Example: an 8GB host with no reserve and no Docker workers fits ~12 × 640MB
# children, so the count cap (8) binds first. On a 4GB host ~6 fit, so the budget
# binds before the count.
# TASK_ORCH_LIGHTWEIGHT_MAX_CHILDREN=8
#
# Per-turn tool-round caps for the loop (one round = one model completion
# plus its parallel tool calls). Executors get more headroom because a single
# wake drives a multi-step scan/start/park sequence.
# TASK_ORCH_CHAT_MAX_TOOL_ROUNDS=8
# TASK_ORCH_EXECUTOR_MAX_TOOL_ROUNDS=30
