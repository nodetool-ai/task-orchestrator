# Copy to .env.local and fill in. .env* is gitignored.

# Auth.js v5 — required.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Public origin. Used by NextAuth for redirect URLs and cookie domain.
# Production: https://tasks.nodetool.ai
# Local dev:  http://localhost:3000
NEXTAUTH_URL=https://tasks.nodetool.ai

# Trust the Cloudflare Tunnel as a reverse proxy so NextAuth uses the
# X-Forwarded-Proto/Host headers (https + tasks.nodetool.ai) for cookies
# and callback URLs instead of the underlying http://localhost:3000.
AUTH_TRUST_HOST=true

# Optional: override SQLite location (defaults to ../data.db relative
# to the db/ directory).
# TASK_ORCH_DB=/var/lib/task-orchestrator/data.db

# Optional: point agent sessions at a different checkout. If unset, the
# orchestrator works on its own source tree.
# TASK_ORCH_TARGET_REPO=/path/to/your/repo

# Optional: model + worktree retention for agent runs.
# TASK_ORCH_AGENT_MODEL=claude-sonnet-4-5
# TASK_ORCH_KEEP_WORKTREES=1
# TASK_ORCH_PR_POLL_MS=60000

# GitHub webhook receiver (POST /api/github/webhook). Set this to a shared
# secret and configure the same secret on your repo/org webhook. Inbound
# deliveries are authenticated via the X-Hub-Signature-256 HMAC. Recommended
# events: pull_request, pull_request_review, issue_comment, check_run,
# check_suite, workflow_run (and/or status). Without this set, the endpoint
# returns 503 and ignores all deliveries.
# GITHUB_WEBHOOK_SECRET=

# Optional: auto-fix. When enabled, a CI failure or "changes requested" review
# on a task's PR resumes the agent on the same branch to fix it and re-push
# (re-triggering CI). Off by default — it spends model budget unattended.
# TASK_ORCH_CI_AUTOFIX=1
# TASK_ORCH_CI_AUTOFIX_MAX=3                 # cap auto-fix attempts per run
# TASK_ORCH_CI_AUTOFIX_DEBOUNCE_MS=120000    # ignore repeat triggers in this window
