# Copy to .env.local and fill in. .env* is gitignored.

# Auth.js v5 — required.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Public origin. Used by NextAuth for redirect URLs and cookie domain.
# Production: https://tasks.nodetool.ai
# Local dev:  http://localhost:3000
NEXTAUTH_URL=https://tasks.nodetool.ai

# Trust the Cloudflare Tunnel as a reverse proxy so NextAuth uses the
# X-Forwarded-Proto/Host headers (https + tasks.nodetool.ai) for cookies
# and callback URLs instead of the underlying http://localhost:3000.
AUTH_TRUST_HOST=true

# Optional: override SQLite location (defaults to ../data.db relative
# to the db/ directory).
# TASK_ORCH_DB=/var/lib/task-orchestrator/data.db

# Optional: point agent sessions at a different checkout. If unset, the
# orchestrator works on its own source tree.
# TASK_ORCH_TARGET_REPO=/path/to/your/repo

# Optional: model + worktree retention for agent runs.
# TASK_ORCH_AGENT_MODEL=claude-sonnet-4-5
# TASK_ORCH_KEEP_WORKTREES=1
# TASK_ORCH_PR_POLL_MS=60000

# How a worktree gets node_modules from the repo root.
#   clone (default) — copy-on-write clone (APFS `cp -c`, btrfs/XFS reflink). The
#                     worktree owns a real private tree, so an agent's
#                     `npm install` cannot write through into your root store.
#                     Costs seconds and near-zero disk; falls back to a symlink
#                     on Windows and on filesystems without reflink.
#   link            — the old shared symlink. Instant, but every worktree writes
#                     into one store.
# TASK_ORCH_WORKTREE_NODE_MODULES=clone

# DEFAULT agent SDK backend. 'pi' (default) uses @earendil-works/pi-coding-agent;
# 'claude' uses @anthropic-ai/claude-agent-sdk. The 'claude' backend resolves auth
# like the Claude Code CLI: ANTHROPIC_API_KEY when set, otherwise the claude.ai
# subscription (run `claude login` once, or set CLAUDE_CODE_OAUTH_TOKEN from
# `claude setup-token` for headless use). Each run can override this default:
# the run composers' backend picker, POST bodies' `backend` field, and the CLI's
# --backend=pi|claude all set agent_runs.backend per run. Note: a run's
# resumable session is backend-specific — resumes stay on the run's backend.
# TASK_ORCH_AGENT_BACKEND=pi

# Brave Search tool for chats and agent runs. The tool uses the Web Search API
# endpoint and keeps the subscription token server-side.
# BRAVE_SEARCH_API_KEY=

# 'claude' backend auth, in precedence order (first match wins):
# ANTHROPIC_API_KEY=sk-ant-...   # API billing; takes precedence when set
# CLAUDE_CODE_OAUTH_TOKEN=...     # subscription fallback for headless hosts
#                                 # (from `claude setup-token`); or just run `claude login`

# GitHub webhook receiver (POST /api/github/webhook). Set this to a shared
# secret and configure the same secret on your repo/org webhook. Inbound
# deliveries are authenticated via the X-Hub-Signature-256 HMAC. Recommended
# events: pull_request, pull_request_review, issue_comment, check_run,
# check_suite, workflow_run (and/or status). Without this set, the endpoint
# returns 503 and ignores all deliveries.
# GITHUB_WEBHOOK_SECRET=

# Optional: auto-fix. When enabled, a CI failure or "changes requested" review
# on a task's PR resumes the agent on the same branch to fix it and re-push
# (re-triggering CI). Off by default — it spends model budget unattended.
# TASK_ORCH_CI_AUTOFIX=0                      # auto-fix is ON by default; set 0/false/no/off to disable
# TASK_ORCH_CI_AUTOFIX_MAX=3                 # cap auto-fix attempts per run
# TASK_ORCH_CI_AUTOFIX_DEBOUNCE_MS=120000    # ignore repeat triggers in this window

# Safety cap for implement runs: a worktree turn that ends without a PR re-prompts
# the agent to keep going. This bounds those consecutive no-PR continuations so a
# stuck agent can't loop forever — on exhaustion the run lands `failed`.
# TASK_ORCH_MAX_PR_CONTINUATIONS=25          # max no-PR turns before failing the run

# Optional: proactive scheduler. When enabled, periodically auto-launches an
# agent session on every eligible `todo` task (assignee matches, deps all
# merged, no run already in flight), up to a hard concurrency ceiling — so the
# orchestrator runs autonomously (agent acts → CI gates → merge/block). OFF by
# default; the poll interval is only armed when the master switch is on.
# TASK_ORCH_AUTO_LAUNCH=0                     # master switch: 1/true/yes/on to enable (default off)
# TASK_ORCH_AUTO_LAUNCH_INTERVAL_MS=60000    # poll cadence
# TASK_ORCH_AUTO_LAUNCH_MAX_CONCURRENT=3     # ceiling on active auto-launched runs
# TASK_ORCH_AUTO_LAUNCH_ASSIGNEE=claude      # only tasks with this assignee are eligible
# TASK_ORCH_AUTO_LAUNCH_PLAN=                 # optional: restrict to one plan id (default: all plans)

# ── Discord bridge (npm run pipe) ────────────────────────────────────────────
# Talk to the same chat agent as the web UI (same tools, same persistence) from
# Discord. Standalone & opt-in: the web server never starts it. Create an app +
# bot at https://discord.com/developers/applications, copy the bot token, and
# enable the "Message Content Intent" under Bot → Privileged Gateway Intents.
# Invite the bot with these permissions: "Send Messages", "Read Message History",
# "Create Public Threads", and "Send Messages in Threads" — a message in a normal
# channel opens a thread and the agent session runs inside it. In a guild the
# bot answers only when @-mentioned (or inside a thread it opened itself); DMs
# always. Invite it with "Add Reactions" too if you want ❌-as-stop.
#
# PREFERRED PATH: configure the bots in the web UI (Settings -> Discord). The
# guided wizard walks through creating the Discord application, verifying the
# token, linking your own Discord user id and inviting the bot, and stores it in
# the database — no redeploy to add a bot. The env vars below still work and are
# merged in as a fallback; a bot configured in Settings wins for its persona.
# Either way the pipe reads its config once at boot: restart `npm run pipe`
# after a change.
#
# Since M4 the bridge is MULTI-BOT: one Discord application per persona. The
# suffix is the persona id in upper-snake ('planning-agent' -> PLANNING_AGENT).
# Only personas with a SERVER-SAFE tools profile qualify (concierge, executor
# today); 'qa' does not — its profile reads the repo, and the pipe refuses to
# boot rather than granting that from a chat message. See the "Persona bots on
# Discord" section in README.md.
# DISCORD_BOT_TOKEN_<PERSONA_ID>=...   # e.g. DISCORD_BOT_TOKEN_CONCIERGE
# DISCORD_APP_ID_<PERSONA_ID>=...      # optional; enables slash-command registration
# DISCORD_BOT_TOKEN=
#
# The legacy single-bot token above binds to DISCORD_DEFAULT_PERSONA (default
# 'implementor'). Persona conversations run IN this process, so their persona
# must have a server-safe (orchestration-only) tools profile — 'implementor' is
# not one, and the pipe refuses to boot in that case by design. Point it at a
# server-safe persona instead — 'concierge' is the end-user-facing default,
# 'executor' the plan-driving one:
# DISCORD_DEFAULT_PERSONA=concierge
#
# Comma-separated Discord USER ids allowed to talk to the bot. An allowlist is
# MANDATORY — the agent runs with bypassPermissions and full shell/fs access in
# the default repo, so the bridge refuses to start without one — but you no
# longer have to curate it here: everyone who links their own Discord id in
# Settings -> Discord is allowed, and these ids are UNIONed on top for legacy
# deployments. (Enable Developer Mode in Discord, then right-click a user → Copy
# User ID.)
# DISCORD_ALLOWED_USERS=111111111111111111,222222222222222222
#
# Optional: restrict to specific channel/DM ids (empty = any channel the
# allow-listed user can reach the bot in).
# DISCORD_ALLOWED_CHANNELS=
#
# Optional per-bot overrides of the two lists above. An override REPLACES the
# global list (it does not extend it): "only these people get the QA bot".
# DISCORD_ALLOWED_USERS_<PERSONA_ID>=
# DISCORD_ALLOWED_CHANNELS_<PERSONA_ID>=
#
# Optional: throttle for in-place streaming edits, in ms (default 750). Discord
# rate-limits message edits, so keep this comfortably above ~500ms.
# TASK_ORCH_PIPE_EDIT_MS=750
#
# Optional: how often the breadcrumb relay polls child-run state, in ms
# (default 15000; 0 disables the relay entirely).
# TASK_ORCH_PIPE_RELAY_POLL_MS=15000
#
# Optional: agent-turn cap per persona conversation before the long-thread guard
# resets it with a carried-over summary (default 60).
# TASK_ORCH_PIPE_TURN_CAP=60
#
# Optional: how long a turn may run before the persona acks it with 👀, in ms
# (default 5000; 0 disables the ack reaction).
# TASK_ORCH_PIPE_ACK_MS=5000
#
# Optional: expose the pipe's own Prometheus metrics (PRD §11 messaging
# counters) on http://127.0.0.1:<port>/metrics. 0/unset = no listener. The web
# app's /api/metrics serves the same registry but from a different process, so
# it only carries the DB-derived messaging gauges without this.
# TASK_ORCH_PIPE_METRICS_PORT=0
#
# Public base URL of the web UI, used to build the deep links personas and the
# /status digest put next to every task/plan/run id. No trailing slash; when
# unset the links are emitted as bare paths (/runs/214).
# TASK_ORCH_PUBLIC_URL=https://tasks.example.com
#
# The bridge reuses TASK_ORCH_CHAT_MODEL (default openai/gpt-5.6-sol) as
# the per-conversation model and TASK_ORCH_TARGET_REPO as the working repo.

# ── Worker WebSocket channel (docs/worker-websocket-protocol.md) ────────────
# The worker protocol is WebSocket-only: the control plane dials each dispatched
# worker's private listener and pushes the run. Workers NEVER receive
# DATABASE_URL and make no outbound control-plane request, so there is no worker
# API URL or token to configure. The channel credential is derived from
# TASK_ORCH_WORKER_CHANNEL_SECRET (defaults to AUTH_SECRET when unset).
# TASK_ORCH_WORKER_CHANNEL_SECRET=

# ── Box managed runners (docs/box-deployment.md) ───────────────────────────
# Set TASK_ORCH_RUNNER=box only on the CONTROL PLANE. BOX_API_KEY is an
# account-level control-plane secret: never put it in a Box template, fork
# environment, worker shell profile, repository, or agent prompt.
# TASK_ORCH_RUNNER=box
# BOX_API_KEY=replace-with-a-control-plane-secret
#
# Stopped template Box used for each first turn. The template contains the
# worker runtime and selected repository, but NO runtime credentials.
# TASK_ORCH_BOX_BASE_URL=https://ascii.dev/api/box/v1
# TASK_ORCH_BOX_TEMPLATE_ID=bx_replace_with_stopped_template
# TASK_ORCH_BOX_TEMPLATE_VERSION=2026-07-14-worker-v1
# TASK_ORCH_BOX_REPO_PATH=/home/user/repository
#
# App-managed templates (DEFAULT): leave TASK_ORCH_BOX_TEMPLATE_ID unset and
# the app builds a template per worker build SHA on first dispatch, starting
# from a fresh blank box it creates itself — no base box to provision. BOX_API_KEY
# alone is enough. Live progress shows in the run view. A pinned TEMPLATE_ID
# disables app-managed builds. Overrides (all optional):
# TASK_ORCH_BOX_WORKER_REPO_URL=https://github.com/nodetool-ai/task-orchestrator.git
# TASK_ORCH_BOX_WORKER_REPO_REF=main
# TASK_ORCH_BOX_AGENT_REPO_URL=https://github.com/nodetool-ai/nodetool.git
# TASK_ORCH_BOX_AGENT_REPO=nodetool-ai/nodetool
# TASK_ORCH_BOX_BUILD_STEP_TIMEOUT_S=900
# TASK_ORCH_WORKER_SHA=                       # git-less deployments only
#
# Timing and capacity controls. All values are milliseconds except MAX_ACTIVE.
# A MAX_ACTIVE value of 0 uses the Box account limit without an app-level cap.
# TASK_ORCH_BOX_IDLE_STOP_MS=30000
# TASK_ORCH_BOX_POLL_MS=5000
# TASK_ORCH_BOX_READY_TIMEOUT_MS=120000
# TASK_ORCH_BOX_RETENTION_MS=2592000000
# TASK_ORCH_BOX_MAX_ACTIVE=0
#
# Structured logging for the worker protocol surfaces (both ends).
# TASK_ORCH_LOG_LEVEL=info                    # debug | info | warn | error
# TASK_ORCH_LOG_FORMAT=text                   # text | json

# ── pi-ai turn tuning (chat + plan executor) ────────────────────────────────
# Per-turn tool-round caps for pi-backend runs (one round = one model completion
# plus its parallel tool calls). Executors get more headroom because a single
# wake drives a multi-step scan/start/park sequence.
# TASK_ORCH_CHAT_MAX_TOOL_ROUNDS=8
# TASK_ORCH_EXECUTOR_MAX_TOOL_ROUNDS=30
