# syntax=docker/dockerfile:1
# Task Orchestrator web server (Next.js). Also used for the `pipe` service
# (same image, different command).

FROM node:24-bookworm-slim AS deps
WORKDIR /app
# .npmrc carries legacy-peer-deps=true (the claude-agent-sdk zod peer is cosmetic).
COPY package.json package-lock.json .npmrc ./
RUN npm ci

FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# `next build` evaluates modules that create the postgres.js client from
# DATABASE_URL at import. postgres.js connects lazily, so a throwaway URL is
# enough to compile — no database is contacted during the build.
ENV DATABASE_URL=postgres://build:build@localhost:5432/build
RUN npm run build
# The standalone worker bundle served by GET /api/worker-bundle to
# blank-provisioned Box runners. Version-locked to this image by construction.
# There is no .git in this build context, so the build script's git-HEAD
# resolution can't fire here — GIT_SHA is what bakes the sha sidecar file.
ARG GIT_SHA
RUN GIT_SHA=$GIT_SHA npm run build:worker:standalone

# The terminal cockpit (`orch`). tui/ is its own package with its own lockfile
# (it is deliberately NOT a root workspace — see tui/README.md), so install its
# deps here before bundling. Both live only in this build stage: the runtime
# stage copies dist/ and nothing else from tui/, so ink + react + tui/node_modules
# never reach the shipped image. dist/orch.js is fully self-contained.
RUN npm --prefix tui ci && npm run build:orch

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
# The server's GitHub I/O (gh_pr__* / gh_ci__* tools, the PR→task sync poller,
# the mergeability probe) now runs in-process via the Octokit client
# (lib/github-client.ts), authenticating from GH_TOKEN / GITHUB_TOKEN in the
# process env. The `gh` CLI is no longer installed in this image — agent-facing
# `gh` usage lives only in the worker/runner images (Dockerfile.worker,
# Dockerfile.fly-runner), which are unaffected.
ENV NODE_ENV=production
# The migrator reads its .sql files from disk at boot; point it at the copied-in
# folder (the bundled server's __dirname can't locate db/migrations otherwise).
ENV TASK_ORCH_MIGRATIONS_DIR=/app/db/migrations
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.mjs ./next.config.mjs
COPY --from=build /app/db ./db
COPY --from=build /app/dist ./dist
# `orch` on PATH for `fly ssh console` / `docker exec` sessions: the bundle is
# already chmod +x with its own shebang, so no wrapper script is needed.
RUN ln -sf /app/dist/orch.js /usr/local/bin/orch
# The `pipe` service runs `tsx scripts/pipe.ts` from THIS image, so the runtime
# stage needs the TS source it imports (lib/*, scripts/*, auth) + tsconfig for
# the `@/*` path alias. `next start` ignores these; they don't affect it.
COPY --from=build /app/lib ./lib
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/cli.ts ./cli.ts
COPY --from=build /app/auth.ts ./auth.ts
COPY --from=build /app/auth.config.ts ./auth.config.ts
COPY --from=build /app/middleware.ts ./middleware.ts
COPY --from=build /app/tsconfig.json ./tsconfig.json
EXPOSE 3000
# `npm run start` -> next start. instrumentation.ts runs initDb() (migrate+seed)
# on boot before serving.
CMD ["npm", "run", "start"]
