# syntax=docker/dockerfile:1
# Task Orchestrator web server (Next.js). Also used for the `pipe` service
# (same image, different command).

FROM node:24-bookworm-slim AS deps
WORKDIR /app
# .npmrc carries legacy-peer-deps=true (the claude-agent-sdk zod peer is cosmetic).
COPY package.json package-lock.json .npmrc ./
RUN npm ci

FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# `next build` evaluates modules that create the postgres.js client from
# DATABASE_URL at import. postgres.js connects lazily, so a throwaway URL is
# enough to compile — no database is contacted during the build.
ENV DATABASE_URL=postgres://build:build@localhost:5432/build
RUN npm run build

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
# gh CLI: lib/extensions/gh-pr.ts shells out to `gh` in-process for lightweight
# chat's GitHub tools (gh_pr__*, gh_repo__branches). It picks up GH_TOKEN /
# GITHUB_TOKEN from the process env automatically — no `gh auth login` needed,
# same as the worker/runner images (Dockerfile.worker, Dockerfile.fly-runner).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
# The migrator reads its .sql files from disk at boot; point it at the copied-in
# folder (the bundled server's __dirname can't locate db/migrations otherwise).
ENV TASK_ORCH_MIGRATIONS_DIR=/app/db/migrations
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.mjs ./next.config.mjs
COPY --from=build /app/db ./db
# The `pipe` service runs `tsx scripts/pipe.ts` from THIS image, so the runtime
# stage needs the TS source it imports (lib/*, scripts/*, auth) + tsconfig for
# the `@/*` path alias. `next start` ignores these; they don't affect it.
COPY --from=build /app/lib ./lib
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/cli.ts ./cli.ts
COPY --from=build /app/auth.ts ./auth.ts
COPY --from=build /app/auth.config.ts ./auth.config.ts
COPY --from=build /app/middleware.ts ./middleware.ts
COPY --from=build /app/tsconfig.json ./tsconfig.json
EXPOSE 3000
# `npm run start` -> next start. instrumentation.ts runs initDb() (migrate+seed)
# on boot before serving.
CMD ["npm", "run", "start"]
