# syntax=docker/dockerfile:1
# Task Orchestrator run worker. Spawned ad-hoc (one container per run) by the
# server via the Docker socket. Runs a single agent turn, checks out/pushes to
# GitHub directly, and talks to Postgres over the compose network.
#   docker run --rm ... task-orchestrator-worker:latest <runId>

FROM node:24-bookworm-slim

# git + gh CLI (agents clone/push and open PRs directly with a token).
# ripgrep + fd-find back the pi backend's grep/find tools; without system
# binaries pi tries to download them from GitHub at runtime inside every
# fresh container (slow, and dead on a network-restricted host).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl gnupg ripgrep fd-find \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# .npmrc carries legacy-peer-deps=true (the claude-agent-sdk zod peer is cosmetic).
COPY package.json package-lock.json .npmrc ./
RUN npm ci

# The Claude Agent SDK spawns the `claude` CLI; install it globally. Only the
# claude backend needs it — the pi backend runs in-process from node_modules —
# but the image carries both so TASK_ORCH_AGENT_BACKEND picks at dispatch time.
RUN npm install -g @anthropic-ai/claude-code

COPY . .

# Commit identity + github auth (system-wide, so the non-root `node` user below
# inherits them). The credential helper reads GH_TOKEN at runtime — no token in a
# URL, .git/config, or a persisted git error.
RUN git config --system user.email "agent@task-orchestrator.local" \
    && git config --system user.name "Task Orchestrator Agent" \
    && git config --system credential.helper '!f() { echo username=x-access-token; echo "password=${GH_TOKEN}"; }; f'

# Run as the non-root `node` user (uid 1000): the Claude Code CLI refuses
# --dangerously-skip-permissions (what the SDK's bypassPermissions maps to) as
# root. uid 1000 also matches the host user that owns the mounted ~/.claude, so
# the session store is read/write. /work holds the per-run checkout.
RUN mkdir -p /work && chown -R node:node /work
USER node

# The runId is passed as the container command: `docker run worker:latest <id>`.
ENTRYPOINT ["npx", "tsx", "scripts/run-worker.ts"]
