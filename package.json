{
  "name": "task-orchestrator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Self-contained SQLite-backed task orchestrator with Next.js UI, CLI, REST API, and Claude Agent SDK sessions.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx cli.ts",
    "chat": "tsx scripts/worker-chat.ts",
    "task": "tsx cli.ts",
    "pipe": "tsx scripts/pipe.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "SEED_DEMO=1 tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "build:worker": "esbuild scripts/run-worker.ts --bundle --platform=node --format=esm --packages=external --alias:@=. --outfile=dist/run-worker.js",
    "build:worker:standalone": "node scripts/build-worker-standalone.mjs",
    "orch": "node tui/bin/orch.mjs",
    "build:orch": "node tui/scripts/build-orch.mjs",
    "test:box-live": "tsx scripts/box-feasibility.ts",
    "trace-run": "tsx scripts/trace-run.ts",
    "gc": "tsx scripts/worktree-gc.ts",
    "isolate-env": "tsx scripts/isolate-worktree-env.ts",
    "worktree-dev": "tsx scripts/worktree-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.178",
    "@anthropic-ai/sdk": "^0.104.2",
    "@asciidev/box-sdk": "^0.0.24",
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "discord.js": "^14.26.4",
    "dockerode": "^4.0.12",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.3",
    "isomorphic-dompurify": "^2.20.0",
    "lucide-react": "^0.460.0",
    "marked": "^15.0.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.31",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "typebox": "^1.1.0",
    "ws": "^8.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/better-sqlite3": "^7.6.11",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0"
  }
}
