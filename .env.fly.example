# Environment for a Fly.io deploy via `./scripts/fly-deploy.sh`.
#
# These are read by the deploy script (which stages them as Fly *secrets* on the
# web app) — they are NOT baked into any image. Copy to `.env.fly`, fill in, then:
#   set -a; . ./.env.fly; set +a; ./scripts/fly-deploy.sh

# --- App / infra names (optional; sensible defaults shown) ---
FLY_APP=task-orchestrator
# FLY_PG_APP=task-orchestrator-db            # default: ${FLY_APP}-db
FLY_REGION=ams
FLY_ORG=personal

# --- Database ---
# Leave DATABASE_URL unset to have the script provision + attach a Fly Postgres.
# Set it to bring your own (e.g. Supabase SESSION pooler on :5432, or Fly MPG).
# DATABASE_URL=postgres://user:pass@host:5432/task_orchestrator

# --- Auth ---
# AUTH_SECRET is generated automatically if unset. NEXTAUTH_URL defaults to
# https://${FLY_APP}.fly.dev — override if you put a custom domain in front.
# AUTH_SECRET=
# NEXTAUTH_URL=https://tasks.example.com

# First dashboard login (created over `fly ssh` after deploy). Optional.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Sprites API token (control plane only; never forwarded to workers).
SPRITES_TOKEN=

# --- Credentials passed to workers ---
# GitHub token for clone/push (HTTPS) and `gh pr create`. Needs `repo` AND
# `workflow` scope — without `workflow`, GitHub rejects any push whose diff
# touches `.github/workflows/*.yml` (classic PAT: check both boxes; fine-grained
# PAT: Contents + Workflows = Read and write).
GH_TOKEN=

# Claude auth: an API key OR a claude.ai OAuth token (`claude setup-token`).
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# pi backend (TASK_ORCH_AGENT_BACKEND=pi) provider keys. Any of these set on
# the web app is forwarded into each worker env. The full recognized
# list lives in lib/agent-backend/provider-env.ts.
# OPENAI_API_KEY=
# Optional override; preferred Codex source is CODEX_HOME/auth.json.
# CODEX_ACCESS_TOKEN=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=

# Brave Search tool for chat and agent web lookup.
# BRAVE_SEARCH_API_KEY=

# --- Optional: GitHub webhooks (PR/CI feedback) ---
# GITHUB_WEBHOOK_SECRET=
