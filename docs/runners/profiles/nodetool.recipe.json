{
  "repositoryId": "R-default",
  "repository": "https://github.com/nodetool-ai/nodetool.git",
  "allowedUserIds": [
    1
  ],
  "target": 1,
  "nodeVersion": "v22.22.3",
  "architecture": "x64",
  "packageManagerVersion": "10.9.8",
  "installOptions": [
    "--no-audit",
    "--no-fund",
    "--include=dev",
    "--include=optional"
  ],
  "reusePolicy": "inputs",
  "installScriptInputs": [
    "electron/scripts/rebuild-native.mjs"
  ],
  "setupCommands": [
    "sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential pkg-config python3 libsecret-1-dev ca-certificates && pkg-config --exists libsecret-1"
  ],
  "buildCommands": [
    "NODE_ENV= npm run build:packages"
  ],
  "readinessCommands": [
    "node -e \"require.resolve('jest/package.json');require.resolve('typescript/package.json');require.resolve('turbo/package.json');require('sharp');require('keytar');const D=require('better-sqlite3');const d=new D(':memory:');d.close()\""
  ],
  "baseRef": "origin/main",
  "minimumGitHistoryDepth": 100
}
