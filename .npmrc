# @anthropic-ai/claude-agent-sdk declares a zod@^4 peer, but the project pins
# zod@3.25.x — which ships the `zod/v4` subpath the SDK actually needs, and the
# SDK's tool() helper accepts a zod-v3 raw shape. The peer mismatch is therefore
# cosmetic; allow installs to proceed instead of erroring on it.
legacy-peer-deps=true
