# @anthropic-ai/claude-agent-sdk declares a zod@^4 peer, but the SDK's tool()
# accepts a zod-v3 raw shape and our pinned zod (3.25.x) ships the zod/v4 subpath
# the SDK needs, so the conflict is cosmetic. Allow installs to proceed.
#   • legacy-peer-deps        — npm: don't fail on the cosmetic peer conflict.
#   • strict-peer-dependencies — pnpm equivalent: warn, don't error.
legacy-peer-deps=true
strict-peer-dependencies=false

# Share one global content-addressable store across all git worktrees: each
# worktree's node_modules is hardlinked from the store (near-zero disk, fast
# installs). `hoisted` keeps a flat, npm-like layout so undeclared transitive
# imports and the webpack-externalized native packages (better-sqlite3, the pi
# packages, the Claude Agent SDK) resolve exactly as they did under npm.
node-linker=hoisted
