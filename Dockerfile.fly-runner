# syntax=docker/dockerfile:1
# Fly Machines runner image. One Fly Machine runs one already-claimed agent run
# against a persistent volume mounted at /mnt/session.

# node 22 to match the primary target repo (nodetool pins node >=22 <23); its
# baked node_modules ships native modules (better-sqlite3) whose ABI must match
# the node the agent runs. task-orchestrator's own worker is pure JS, so it runs
# fine on 22 too.
FROM node:22-bookworm-slim

# System packages fall in two groups:
#   • runtime CLIs the agent skill/document/video nodes shell out to (ffmpeg,
#     poppler, qpdf, pandoc, …) — mirrors nodetool's own runtime Dockerfile.
#   • native BUILD toolchain nodetool's `npm ci` needs to compile native modules
#     (build-essential, pkg-config, libsecret-1-dev, python3-pip).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      git ca-certificates curl gnupg openssh-client ripgrep fd-find jq gosu \
      ffmpeg zip unzip poppler-utils qpdf pandoc postgresql-client \
      python3 python3-venv python3-pip \
      build-essential pkg-config libsecret-1-dev \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
# Keep dev dependencies: the existing worker entrypoint is TypeScript and runs via tsx.
RUN npm ci
RUN npm install -g @anthropic-ai/claude-code

# Python tooling for document/media workflows, isolated in a venv on PATH:
# yt-dlp (downloads), pypdf/pdfplumber/pypdfium2 (PDF read/parse), reportlab
# (PDF generation).
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir \
       yt-dlp pypdf pdfplumber pypdfium2 reportlab \
    && rm -rf /root/.cache
ENV PATH="/opt/venv/bin:$PATH"

# Node document libraries available to agent scripts via NODE_PATH resolution:
# pdf-lib (PDF manipulation) and docx (Word generation).
RUN npm install -g pdf-lib docx && npm cache clean --force
ENV NODE_PATH=/usr/local/lib/node_modules

# ---------------------------------------------------------------------------
# nodetool repo-cache + prewarm — deliberately placed BEFORE `COPY . .`.
#
# These layers depend only on the two scripts copied just below and on the
# nodetool HEAD SHA passed as *_BUST — NOT on task-orchestrator source. So a
# task-orch push where nodetool is unchanged reuses the cached multi-GB
# `npm ci` layer instead of reinstalling nodetool from scratch. (When they sat
# after `COPY . .`, every task-orch push invalidated them and re-ran the whole
# install.) The scripts are copied on their own so editing unrelated source
# doesn't bust this either.
# ---------------------------------------------------------------------------
COPY scripts/build-repo-cache.sh scripts/build-prewarm.sh ./scripts/

# Bake blobless bare mirrors of the hot target repos into the image so per-run
# checkouts fetch only the delta (git clone --reference <mirror> --dissociate).
# REPO_CACHE_REPOS is a space/comma-separated owner/repo list passed at build
# time; the GitHub token arrives as a BuildKit secret (never a persisted layer).
# Both are optional — build-repo-cache.sh exits 0 (seeding nothing) when either
# is absent, so the image always builds and runs fall back to full clones.
ARG REPO_CACHE_REPOS=""
# REPO_CACHE_BUST is nodetool's current HEAD SHA (passed by the workflows). Same
# SHA → this layer cache-hits and the baked mirror is reused; a new nodetool
# commit → new SHA → the layer (and the prewarm below) re-run and refresh.
# Keying on the SHA rather than a timestamp is what lets GitHub's build cache
# skip the expensive seed+install when nodetool hasn't moved.
ARG REPO_CACHE_BUST=""
RUN --mount=type=secret,id=gh_token REPO_CACHE_BUST="$REPO_CACHE_BUST" bash scripts/build-repo-cache.sh /opt/repo-cache "$REPO_CACHE_REPOS"

# Pre-warm the primary target repo: bake a full `npm ci` (root + every workspace
# node_modules) + built packages so an agent run never pays a cold install on a
# fresh volume. lib/prewarm.ts symlinks this tree into the per-run checkout at
# run time (only when the checkout's origin matches). Never fatal —
# build-prewarm.sh exits 0 if the repo/token is absent or a step fails, so the
# image still builds and runs just pay the cold install.
#
# Playwright browsers are intentionally NOT baked (build-prewarm.sh skips the
# install) — a run that needs them installs on demand. PLAYWRIGHT_BROWSERS_PATH
# is still set so any such runtime install lands in one global,
# checkout-independent location.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
ARG PREWARM_REPO="nodetool-ai/nodetool"
# Cache-bust twin of REPO_CACHE_BUST (same nodetool HEAD SHA).
ARG PREWARM_BUST=""
RUN --mount=type=secret,id=gh_token \
    PREWARM_BUST="$PREWARM_BUST" REPO_CACHE_DIR=/opt/repo-cache \
    bash scripts/build-prewarm.sh /opt/nodetool-prewarm "$PREWARM_REPO"
ENV PREWARM_DIR=/opt/nodetool-prewarm

COPY . .

# Pre-bundle the TypeScript worker with esbuild (a devDependency installed by the
# `npm ci` above) so a run boots via `node dist/run-worker.js` instead of paying
# tsx's whole-import-graph transpile cost on every cold start.
RUN npm run build:worker

RUN git config --system user.email "agent@task-orchestrator.local" \
    && git config --system user.name "Task Orchestrator Agent" \
    && git config --system credential.helper '!f() { echo username=x-access-token; echo "password=${GH_TOKEN}"; }; f'

COPY scripts/fly-runner-entry.sh /usr/local/bin/fly-runner-entry
RUN chmod +x /usr/local/bin/fly-runner-entry

# Optional shared agent-config seed. Deployments may bake a .claude directory
# (settings, skills, etc.) into /opt/claude-seed at build time; the entrypoint
# copies it onto the session volume only when the volume has none of its own.
RUN mkdir -p /opt/claude-seed

ENV SESSION_ROOT=/mnt/session
# Default mirror dir for the worker's --reference lookup (a concurrent change
# also passes this via Machine env); the seed above lands here.
ENV REPO_CACHE_DIR=/opt/repo-cache
# The bundled worker runs from /app/dist, so db/index.ts's import.meta.url-based
# default migrations-dir would resolve wrong; pin it. Insurance — the worker
# does not migrate in practice.
ENV TASK_ORCH_MIGRATIONS_DIR=/app/db/migrations
ENTRYPOINT ["/usr/local/bin/fly-runner-entry"]
