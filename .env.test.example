# Test-deployment env. Copy to `.env.test`, fill the REQUIRED values, then:
#   scripts/test-deploy.sh up
# This stack is isolated (project task-orch-test, throwaway volumes) — safe to
# stand up alongside prod.

# --- Postgres (throwaway; any value) ---
POSTGRES_PASSWORD=testpw

# --- Server ---
# A non-conflicting host port (prod's next-server uses 3000).
SERVER_PORT=3005
AUTH_SECRET=run__openssl_rand_base64_32__and_paste_here
NEXTAUTH_URL=http://localhost:3005

# --- Models / backend ---
TASK_ORCH_AGENT_BACKEND=claude
TASK_ORCH_CHAT_MODEL=anthropic/claude-opus-4-8
TASK_ORCH_AGENT_MODEL=anthropic/claude-opus-4-8

# --- REQUIRED for the worker->PR acceptance test ---
# A GitHub token with `repo` scope on the TEST repo below (git clone/push + gh pr create).
GH_TOKEN=ghp_your_scoped_token
# Space-separated owner/repo to mirror into the repo-cache. Use a THROWAWAY repo.
TARGET_REPOS=your-user/orch-sandbox
# Host ~/.claude (Claude Code auth + session store), mounted into server + workers.
CLAUDE_HOME=/home/claude/.claude
# Claude auth: an OAuth token from ~/.claude, OR an API key. (CLAUDE_HOME usually suffices.)
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# --- Optional: Discord pipe (leave blank to skip) ---
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_CHANNELS=
